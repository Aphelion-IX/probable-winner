# Supabase (browser-safe values only — never put the service-role key here
# or in any NEXT_PUBLIC_* variable; see AGENTS.md rule 3).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (server-side only)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Search (B-021/B-084) needs no separate env vars: apps/web downloads the
# MiniSearch index snapshot apps/worker persists directly from Supabase
# Storage (the "search-index" bucket) using the NEXT_PUBLIC_SUPABASE_* client
# above, caching it in memory per serverless function instance (see
# apps/web/src/lib/search-index-cache.ts). Run the worker locally
# (pnpm --filter worker dev, then pnpm --filter worker reindex-search once)
# to produce a snapshot for local dev to load.
