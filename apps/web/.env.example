# Supabase (browser-safe values only — never put the service-role key here
# or in any NEXT_PUBLIC_* variable; see AGENTS.md rule 3).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe (server-side only)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Search (B-021/B-084). apps/worker keeps a MiniSearch index resident in
# memory and exposes it over HTTP (apps/worker/src/search/http-server.ts) --
# server-side only here, the search API route proxies all queries, so the
# token is never sent to the browser. For local dev, run the worker
# (pnpm --filter worker dev) and point this at it.
SEARCH_SERVICE_URL=http://localhost:8087
SEARCH_SERVICE_TOKEN=local-dev-search-service-token
