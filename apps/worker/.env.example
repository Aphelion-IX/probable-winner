# Direct Postgres connection string for the Supabase project (Session Pooler
# or direct connection, NOT the anon/publishable REST key). The worker talks
# to Postgres directly — it is a trusted backend process, not browser code.
# Find it in Supabase Dashboard > Project Settings > Database.
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Search (B-021/B-084). This worker keeps a MiniSearch index resident in
# memory. apps/web reads it via the Supabase Storage snapshot below, not
# this HTTP server -- these vars are only for this server's admin-only
# routes (apps/worker/src/search/http-server.ts): /health, and the
# /admin/reindex + /admin/recalculate-popularity-scores endpoints the
# reindex-search/update-popularity-scores scripts call (rather than
# mutating their own separate process's index, which the live worker would
# never see). SEARCH_SERVICE_PORT is what it listens on; SEARCH_SERVICE_URL/
# SEARCH_SERVICE_TOKEN are what those scripts use to reach it -- pointed at
# this same worker, so SEARCH_SERVICE_URL is normally just localhost.
SEARCH_SERVICE_PORT=8087
SEARCH_SERVICE_URL=http://localhost:8087
SEARCH_SERVICE_TOKEN=local-dev-search-service-token

# Supabase project URL + service-role key (NOT the anon/publishable key).
# Used to persist the MiniSearch snapshot to Supabase Storage (the
# "search-index" bucket, migrations 20260728020000/20260728030000) -- both
# so this worker can load it back on its own restart (a fast-restart
# accelerator, not a hard dependency -- it falls back to a full rebuild from
# Postgres) and so apps/web can download it directly (via its own anon key,
# not this service-role key -- see the read policy in 20260728030000). Find
# both in Supabase Dashboard > Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (transactional email, blueprint §3.3). Used by the restock_alerts
# queue consumer to send restock/price-drop notifications (B-192). Get an
# API key from https://resend.com/api-keys; RESEND_FROM_EMAIL must be a
# sender address/domain verified on that Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
